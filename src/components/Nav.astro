---
const links = [
  { href: '/pre-skoly', label: 'Pre školy' },
  { href: '/pre-firmy', label: 'Pre firmy' },
  { href: '/pre-lektorov', label: 'Pre lektorov' },
  { href: '/cennik', label: 'Cenník' },
];
const path = Astro.url.pathname;
---
<header class="border-b border-navy/10 bg-paper/85 backdrop-blur sticky top-0 z-50 no-print">
  <div class="max-w-6xl mx-auto px-5 sm:px-8 h-16 flex items-center justify-between gap-6">
    <a href="/" class="flex items-baseline gap-2 group" aria-label="EduLinker — domov">
      <span class="font-serif text-2xl tracking-tightest text-navy leading-none">Edu<span class="text-teal">·</span>Linker</span>
    </a>
    <nav class="hidden md:flex items-center gap-7 text-sm">
      {links.map(({ href, label }) => (
        <a
          href={href}
          class={`text-ink-muted hover:text-navy transition-colors ${path === href ? 'text-navy font-medium' : ''}`}
        >{label}</a>
      ))}
      <a href="mailto:patrik@edulinker.cz?subject=EduLinker%20%E2%80%94%20chcem%20audit" class="text-sm font-medium text-paper bg-navy px-4 py-2 rounded-sm hover:bg-navy-mid transition-colors">
        Dohodnúť audit
      </a>
    </nav>
    <details class="md:hidden relative">
      <summary class="list-none cursor-pointer px-2 py-2 -mr-2 text-navy" aria-label="Menu">
        <svg width="22" height="22" viewBox="0 0 22 22" aria-hidden="true"><path d="M3 6h16M3 11h16M3 16h16" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
      </summary>
      <div class="absolute right-0 mt-2 w-60 bg-paper border border-navy/15 rounded-sm py-3 shadow-lg">
        {links.map(({ href, label }) => (
          <a href={href} class="block px-5 py-2 text-sm text-ink hover:bg-paper-tint">{label}</a>
        ))}
        <div class="mx-5 my-2 h-px bg-navy/10"></div>
        <a href="mailto:patrik@edulinker.cz" class="block px-5 py-2 text-sm font-medium text-teal">Dohodnúť audit →</a>
      </div>
    </details>
  </div>
</header>
